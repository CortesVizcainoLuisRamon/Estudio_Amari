# Copia este archivo como .env y llena tus valores. El archivo .env NUNCA se sube a GitHub.

# Base de datos (en tu computadora con WampServer normalmente: localhost, 3306, root, sin contraseña)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=estudio_amari
# Pon true cuando la base esté en la nube (TiDB Cloud, etc.): la conexión debe ir cifrada
DB_SSL=false

# Firma de las sesiones. Usa una cadena larga y aleatoria, distinta en cada entorno.
# Para generar una: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=7d

# Fotos en la nube (solo en producción). Si se deja vacío, las fotos se guardan en server/uploads.
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
